<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>YUVORAI — Admin Intelligence Hub</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&family=Figtree:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root{
  --bg:#07070f;--bg2:#0d0d1c;--bg3:#111125;--card:#13132a;
  --b1:rgba(120,80,255,0.1);--b2:rgba(120,80,255,0.2);--b3:rgba(120,80,255,0.35);
  --pu:#7c50ff;--vi:#5b21b6;--pk:#e879f9;--cy:#06d6a0;
  --gr:#10b981;--am:#fbbf24;--rd:#f43f5e;--bl:#38bdf8;
  --t1:#ede9ff;--t2:#8878bb;--t3:#2e2a55;
  --d:'Syne',sans-serif;--b:'Figtree',sans-serif;--mono:'DM Mono',monospace;
  --r:13px;--rl:18px;--sidebar:235px;
  --gp:0 0 40px rgba(124,80,255,0.2),0 0 80px rgba(124,80,255,0.08);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--t1);font-family:var(--b);overflow-x:hidden;-webkit-font-smoothing:antialiased;}
button,input,select{font-family:var(--b);cursor:pointer;}
a{color:inherit;text-decoration:none;}

body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(ellipse 50% 60% at 10% 20%,rgba(124,80,255,0.07) 0%,transparent 70%),
    radial-gradient(ellipse 40% 40% at 90% 80%,rgba(232,121,249,0.05) 0%,transparent 70%),
    radial-gradient(ellipse 30% 30% at 50% 50%,rgba(6,214,160,0.03) 0%,transparent 70%);
}

/* GRID PATTERN */
body::after{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:linear-gradient(rgba(124,80,255,0.04) 1px,transparent 1px),
    linear-gradient(90deg,rgba(124,80,255,0.04) 1px,transparent 1px);
  background-size:40px 40px;
  mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(0,0,0,0.5),transparent);
}

/* LOGIN */
#login-page{
  position:fixed;inset:0;z-index:999;
  display:flex;align-items:center;justify-content:center;padding:1rem;
  background:var(--bg);
}
.login-box{width:100%;max-width:400px;position:relative;z-index:2;animation:fadeUp .6s ease;}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

.lb-logo{text-align:center;margin-bottom:2rem;}
.lb-mark{
  display:inline-flex;align-items:center;justify-content:center;
  width:58px;height:58px;border-radius:15px;
  background:linear-gradient(135deg,var(--pu),var(--pk));
  font-family:var(--d);font-weight:800;font-size:20px;color:#fff;
  margin-bottom:14px;box-shadow:var(--gp);
}
.lb-logo h1{font-family:var(--d);font-size:28px;font-weight:800;background:linear-gradient(90deg,var(--pu),var(--pk));-webkit-background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:-1px;}
.lb-logo .sub{font-size:11px;color:var(--t3);font-family:var(--mono);letter-spacing:2px;margin-top:4px;}

.lb-card{
  background:var(--card);border:1px solid var(--b2);border-radius:var(--rl);
  padding:2rem;position:relative;overflow:hidden;
  box-shadow:0 30px 70px rgba(0,0,0,0.6);
}
.lb-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--pu),var(--pk),transparent);}
.field-label{display:block;font-size:10.5px;color:var(--t2);text-transform:uppercase;letter-spacing:1px;margin-bottom:7px;font-family:var(--mono);}
.field-input{
  width:100%;background:var(--bg2);border:1px solid var(--b2);border-radius:10px;
  padding:11px 14px;color:var(--t1);font-size:13.5px;outline:none;transition:all .2s;margin-bottom:1rem;
}
.field-input:focus{border-color:var(--pu);box-shadow:0 0 15px rgba(124,80,255,0.2);}
.login-btn{
  width:100%;padding:12px;border-radius:11px;border:none;
  background:linear-gradient(135deg,var(--pu),var(--pk));
  color:#fff;font-size:14px;font-weight:600;font-family:var(--d);
  letter-spacing:0.5px;transition:all .2s;margin-top:6px;
  box-shadow:0 8px 30px rgba(124,80,255,0.35);
}
.login-btn:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(124,80,255,0.5);}
.login-hint{font-size:11px;color:var(--t3);text-align:center;margin-top:14px;font-family:var(--mono);}
.login-error{color:var(--rd);font-size:12px;text-align:center;margin-top:10px;display:none;}

/* SIDEBAR */
.sidebar{
  position:fixed;left:0;top:0;bottom:0;width:var(--sidebar);
  background:var(--bg2);border-right:1px solid var(--b1);
  display:flex;flex-direction:column;z-index:300;
}
.sb-logo{
  height:64px;display:flex;align-items:center;gap:11px;
  padding:0 1.2rem;border-bottom:1px solid var(--b1);flex-shrink:0;
}
.logo-mark{
  width:34px;height:34px;border-radius:9px;flex-shrink:0;
  background:linear-gradient(135deg,var(--pu),var(--pk));
  display:flex;align-items:center;justify-content:center;
  font-family:var(--d);font-weight:800;font-size:12px;color:#fff;
  box-shadow:0 0 20px rgba(124,80,255,0.4);
}
.logo-text{font-family:var(--d);font-weight:800;font-size:14.5px;background:linear-gradient(90deg,var(--pu),var(--pk));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.logo-sub2{font-size:9px;color:var(--t3);font-family:var(--mono);letter-spacing:1px;}

.nav-scroll{flex:1;overflow-y:auto;padding:1rem 0.7rem;}
.nav-scroll::-webkit-scrollbar{width:3px;}
.nav-scroll::-webkit-scrollbar-thumb{background:var(--b2);border-radius:3px;}
.nav-sec{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--t3);padding:0 0.5rem;margin:1.1rem 0 5px;font-family:var(--mono);}
.nav-sec:first-child{margin-top:0;}
.ni{
  display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:10px;
  font-size:13px;color:var(--t2);transition:all .18s;margin-bottom:2px;
  position:relative;cursor:pointer;border:1px solid transparent;
}
.ni:hover{background:rgba(124,80,255,0.07);color:var(--t1);}
.ni.active{
  background:linear-gradient(90deg,rgba(124,80,255,0.17),rgba(232,121,249,0.07));
  color:var(--pu);border-color:rgba(124,80,255,0.22);
}
.ni.active::before{
  content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);
  width:3px;height:55%;border-radius:0 2px 2px 0;
  background:linear-gradient(180deg,var(--pu),var(--pk));
}
.ni i{width:16px;text-align:center;font-size:13px;flex-shrink:0;}
.nbadge{
  margin-left:auto;font-size:9px;
  background:linear-gradient(135deg,var(--pu),var(--pk));
  color:#fff;border-radius:20px;padding:2px 7px;font-family:var(--mono);font-weight:700;
}
.nbadge.warn{background:linear-gradient(135deg,var(--am),var(--rd));}
.nbadge.ok{background:linear-gradient(135deg,var(--cy),var(--bl));}

.sb-foot{padding:0.75rem;border-top:1px solid var(--b1);flex-shrink:0;}
.sb-user{
  display:flex;align-items:center;gap:9px;padding:9px 11px;
  border-radius:11px;border:1px solid var(--b2);background:var(--bg3);
}
.av{
  width:32px;height:32px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:700;font-family:var(--d);
  background:linear-gradient(135deg,var(--pu),var(--pk));color:#fff;
  box-shadow:0 0 12px rgba(124,80,255,0.4);
}
.su-name{font-size:12.5px;font-weight:600;}
.su-role{font-size:10px;font-family:var(--mono);background:linear-gradient(90deg,var(--cy),var(--pu));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}

/* TOPBAR */
.topbar{
  position:fixed;top:0;left:var(--sidebar);right:0;height:64px;z-index:200;
  background:rgba(7,7,15,0.9);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--b1);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 clamp(1rem,3vw,2rem);
}
.topbar::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--pu),var(--pk),var(--cy),transparent);opacity:0.5;}
.page-title{font-family:var(--d);font-weight:800;font-size:16px;background:linear-gradient(90deg,var(--pu),var(--pk));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.topbar-right{display:flex;align-items:center;gap:8px;}
.live-pill{
  display:flex;align-items:center;gap:6px;
  background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2);
  border-radius:100px;padding:6px 13px;font-size:11px;color:var(--gr);font-family:var(--mono);
}
.pulse{width:7px;height:7px;border-radius:50%;background:var(--gr);box-shadow:0 0 8px var(--gr);animation:pulse 1.8s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.tb-btn{
  display:flex;align-items:center;gap:6px;background:var(--card);border:1px solid var(--b2);
  color:var(--t2);border-radius:10px;padding:7px 13px;font-size:12px;transition:all .2s;
}
.tb-btn:hover{border-color:var(--pu);color:var(--pu);box-shadow:0 0 15px rgba(124,80,255,0.2);}
#logout-btn{border-color:rgba(244,63,94,0.3);color:var(--rd);}
#logout-btn:hover{background:rgba(244,63,94,0.08);border-color:var(--rd);}

/* MAIN */
.main{margin-left:var(--sidebar);padding:80px clamp(1rem,3vw,2rem) 2.5rem;min-height:100vh;position:relative;z-index:1;}

/* PAGES */
.page{display:none;}
.page.active{display:block;animation:fadeIn .3s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* SECTION HEADER */
.sec-hdr{display:flex;align-items:center;gap:10px;margin-bottom:1rem;font-family:var(--mono);font-size:10px;letter-spacing:2px;color:var(--t3);text-transform:uppercase;}
.sec-hdr::before{content:'//';color:var(--pu);margin-right:2px;}
.sec-hdr::after{content:'';flex:1;height:1px;background:var(--b1);}

/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:1.2rem;}
.sc{
  background:var(--card);border:1px solid var(--b1);border-radius:var(--r);
  padding:1.1rem 1.2rem;position:relative;overflow:hidden;transition:all .25s;cursor:default;
}
.sc::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;}
.sc:hover{transform:translateY(-3px);border-color:var(--b2);}
.sc.pu::before{background:linear-gradient(90deg,var(--pu),transparent);}
.sc.pk::before{background:linear-gradient(90deg,var(--pk),transparent);}
.sc.cy::before{background:linear-gradient(90deg,var(--cy),transparent);}
.sc.gr::before{background:linear-gradient(90deg,var(--gr),transparent);}
.sc.am::before{background:linear-gradient(90deg,var(--am),transparent);}
.sc.rd::before{background:linear-gradient(90deg,var(--rd),transparent);}
.sc.bl::before{background:linear-gradient(90deg,var(--bl),transparent);}
.sc-icon{font-size:17px;margin-bottom:9px;}
.sc.pu .sc-icon{color:var(--pu);}
.sc.pk .sc-icon{color:var(--pk);}
.sc.cy .sc-icon{color:var(--cy);}
.sc.gr .sc-icon{color:var(--gr);}
.sc.am .sc-icon{color:var(--am);}
.sc.rd .sc-icon{color:var(--rd);}
.sc.bl .sc-icon{color:var(--bl);}
.sc-lbl{font-size:10px;color:var(--t2);margin-bottom:5px;font-family:var(--mono);text-transform:uppercase;letter-spacing:.5px;}
.sc-val{font-size:22px;font-weight:800;font-family:var(--d);letter-spacing:-1px;}
.sc-delta{font-size:11px;margin-top:4px;font-family:var(--mono);}
.up{color:var(--gr);} .dn{color:var(--rd);}

/* CHARTS */
.charts-row{display:grid;grid-template-columns:2fr 1fr;gap:10px;margin-bottom:1.2rem;}
.cc{background:var(--card);border:1px solid var(--b1);border-radius:var(--r);padding:1.3rem;position:relative;overflow:hidden;}
.cc::after{content:'';position:absolute;inset:0;border-radius:var(--r);background:radial-gradient(ellipse at top right,rgba(124,80,255,0.04),transparent 60%);pointer-events:none;}
.cc-title{font-size:10px;font-weight:600;color:var(--t2);font-family:var(--mono);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:1rem;display:flex;align-items:center;gap:7px;}
.cc-title .dot{width:6px;height:6px;border-radius:50%;}
.dot-pu{background:var(--pu);box-shadow:0 0 8px var(--pu);}
.dot-pk{background:var(--pk);box-shadow:0 0 8px var(--pk);}
.dot-cy{background:var(--cy);box-shadow:0 0 8px var(--cy);}
.dot-gr{background:var(--gr);box-shadow:0 0 8px var(--gr);}
.legend{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:12px;}
.legend span{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--t2);font-family:var(--mono);}
.lsq{width:8px;height:8px;border-radius:2px;flex-shrink:0;}
.donut-wrap{position:relative;}
.donut-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;}
.dc-big{font-size:22px;font-weight:800;font-family:var(--d);letter-spacing:-1px;}
.dc-sm{font-size:10px;color:var(--t2);font-family:var(--mono);}

/* MID ROW */
.mid-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1.2rem;}
.fs{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.fl{font-size:11px;color:var(--t2);width:110px;flex-shrink:0;font-family:var(--mono);}
.fb-wrap{flex:1;background:var(--bg3);border-radius:4px;height:4px;overflow:hidden;}
.fb{height:4px;border-radius:4px;transition:width 1s ease;}
.fn{font-size:11px;font-family:var(--mono);color:var(--t1);min-width:36px;text-align:right;}

/* TABLE CARD */
.tc{background:var(--card);border:1px solid var(--b1);border-radius:var(--r);overflow:hidden;margin-bottom:1.5rem;}
.tc-head{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.3rem;border-bottom:1px solid var(--b1);flex-wrap:wrap;gap:10px;}
.tc-title{font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:8px;}
.search-wrap{display:flex;align-items:center;gap:7px;background:var(--bg2);border:1px solid var(--b2);border-radius:10px;padding:7px 12px;transition:border-color .2s;}
.search-wrap:focus-within{border-color:var(--pu);box-shadow:0 0 12px rgba(124,80,255,0.15);}
.search-wrap input{background:none;border:none;outline:none;color:var(--t1);font-size:12.5px;width:140px;font-family:var(--mono);}
.search-wrap input::placeholder{color:var(--t3);}
.search-wrap i{color:var(--t3);font-size:12px;}
.filter-row{display:flex;gap:6px;padding:0.7rem 1.3rem;flex-wrap:wrap;border-bottom:1px solid var(--b1);}
.pill{font-size:11px;padding:5px 13px;border-radius:100px;border:1px solid var(--b2);color:var(--t2);transition:all .15s;font-family:var(--mono);background:none;}
.pill:hover{border-color:var(--pu);color:var(--pu);}
.pill.active{background:linear-gradient(90deg,rgba(124,80,255,0.15),rgba(232,121,249,0.08));color:var(--pu);border-color:rgba(124,80,255,0.4);}
.tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:620px;}
th{text-align:left;color:var(--t3);font-weight:500;font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:1px;padding:9px 16px;border-bottom:1px solid var(--b1);background:rgba(124,80,255,0.03);}
td{padding:11px 16px;border-bottom:1px solid var(--b1);vertical-align:middle;}
tr:last-child td{border-bottom:none;}
tr:hover td{background:rgba(124,80,255,0.03);}
.uc{display:flex;align-items:center;gap:10px;}
.av-sm{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;font-family:var(--d);flex-shrink:0;}
.u-name{font-weight:500;white-space:nowrap;}
.u-email{font-size:11px;color:var(--t2);font-family:var(--mono);}
.badge{display:inline-flex;align-items:center;gap:4px;font-size:10.5px;padding:3px 9px;border-radius:100px;font-family:var(--mono);}
.b-active{background:rgba(16,185,129,0.1);color:var(--gr);border:1px solid rgba(16,185,129,0.25);}
.b-inactive{background:rgba(244,63,94,0.1);color:var(--rd);border:1px solid rgba(244,63,94,0.25);}
.b-pending{background:rgba(251,191,36,0.1);color:var(--am);border:1px solid rgba(251,191,36,0.25);}
.role-badge{font-size:10px;padding:2px 8px;border-radius:5px;font-family:var(--mono);font-weight:500;}
.role-admin{background:rgba(124,80,255,0.15);color:var(--pu);border:1px solid rgba(124,80,255,0.3);}
.role-mod{background:rgba(56,189,248,0.1);color:var(--bl);border:1px solid rgba(56,189,248,0.25);}
.role-student{background:rgba(255,255,255,0.04);color:var(--t2);border:1px solid var(--b1);}
.action-btns{display:flex;gap:5px;}
.action-btn{
  padding:4px 10px;border-radius:7px;border:1px solid var(--b1);
  color:var(--t2);font-size:11px;font-family:var(--mono);transition:all .15s;background:none;
}
.action-btn:hover{border-color:var(--pu);color:var(--pu);}
.action-btn.del:hover{border-color:var(--rd);color:var(--rd);}
.pb{width:55px;height:3px;background:var(--bg3);border-radius:3px;overflow:hidden;}
.pf{height:3px;border-radius:3px;}

/* ANALYTICS PAGE */
.an-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:1.2rem;}
.an-card{background:var(--card);border:1px solid var(--b1);border-radius:var(--r);padding:1.2rem;}
.an-card h3{font-size:10px;color:var(--t2);font-family:var(--mono);text-transform:uppercase;letter-spacing:1px;margin-bottom:0.8rem;display:flex;align-items:center;gap:7px;}
.metric-big{font-size:32px;font-weight:800;font-family:var(--d);letter-spacing:-2px;background:linear-gradient(90deg,var(--pu),var(--pk));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.metric-sub{font-size:12px;color:var(--t2);font-family:var(--mono);margin-top:4px;}
.heatmap{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-top:8px;}
.hm-cell{height:14px;border-radius:3px;background:var(--bg3);transition:all .2s;}
.hm-cell:hover{transform:scale(1.2);}
.retention-bars{display:flex;flex-direction:column;gap:6px;margin-top:8px;}
.ret-bar{display:flex;align-items:center;gap:10px;}
.ret-label{font-size:10px;font-family:var(--mono);color:var(--t2);width:40px;}
.ret-track{flex:1;height:6px;background:var(--bg3);border-radius:3px;overflow:hidden;}
.ret-fill{height:6px;border-radius:3px;background:linear-gradient(90deg,var(--pu),var(--pk));}
.ret-val{font-size:10px;font-family:var(--mono);color:var(--t1);width:35px;text-align:right;}

/* BOTS PAGE */
.bots-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;margin-bottom:1.2rem;}
.bot-card{
  background:var(--card);border:1px solid var(--b1);border-radius:var(--r);
  padding:1.3rem;position:relative;overflow:hidden;transition:all .25s;
}
.bot-card:hover{border-color:var(--b2);transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,0,0,0.3);}
.bot-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;}
.bot-card.active-bot::before{background:linear-gradient(90deg,var(--cy),transparent);}
.bot-card.paused-bot::before{background:linear-gradient(90deg,var(--am),transparent);}
.bot-card.offline-bot::before{background:linear-gradient(90deg,var(--rd),transparent);}
.bot-header{display:flex;align-items:center;gap:12px;margin-bottom:12px;}
.bot-avatar{
  width:44px;height:44px;border-radius:12px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:20px;
}
.bot-avatar.pu{background:rgba(124,80,255,0.15);border:1px solid rgba(124,80,255,0.3);}
.bot-avatar.cy{background:rgba(6,214,160,0.1);border:1px solid rgba(6,214,160,0.25);}
.bot-avatar.pk{background:rgba(232,121,249,0.1);border:1px solid rgba(232,121,249,0.25);}
.bot-avatar.am{background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.25);}
.bot-avatar.bl{background:rgba(56,189,248,0.1);border:1px solid rgba(56,189,248,0.25);}
.bot-avatar.rd{background:rgba(244,63,94,0.1);border:1px solid rgba(244,63,94,0.25);}
.bot-name{font-size:14px;font-weight:600;font-family:var(--d);}
.bot-type{font-size:10px;color:var(--t2);font-family:var(--mono);margin-top:2px;}
.bot-status-badge{margin-left:auto;}
.bot-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0;}
.bs{background:var(--bg3);border-radius:8px;padding:9px 10px;}
.bs-lbl{font-size:9px;color:var(--t3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.5px;}
.bs-val{font-size:15px;font-weight:700;font-family:var(--d);letter-spacing:-0.5px;margin-top:2px;}
.bot-actions{display:flex;gap:7px;margin-top:12px;}
.bot-btn{
  flex:1;padding:7px;border-radius:8px;border:1px solid var(--b2);
  color:var(--t2);font-size:11.5px;font-family:var(--mono);transition:all .18s;background:none;
  display:flex;align-items:center;justify-content:center;gap:5px;
}
.bot-btn:hover{border-color:var(--pu);color:var(--pu);}
.bot-btn.danger:hover{border-color:var(--rd);color:var(--rd);}
.bot-btn.primary{background:rgba(124,80,255,0.12);border-color:rgba(124,80,255,0.3);color:var(--pu);}
.bot-btn.primary:hover{background:rgba(124,80,255,0.2);}
.toggle-switch{position:relative;display:inline-flex;align-items:center;gap:8px;cursor:pointer;}
.toggle-input{display:none;}
.toggle-track{
  width:40px;height:22px;border-radius:100px;background:var(--bg3);border:1px solid var(--b2);
  position:relative;transition:all .25s;
}
.toggle-input:checked+.toggle-track{background:rgba(6,214,160,0.2);border-color:rgba(6,214,160,0.4);}
.toggle-track::after{
  content:'';position:absolute;top:3px;left:3px;width:14px;height:14px;
  border-radius:50%;background:var(--t3);transition:all .25s;
}
.toggle-input:checked+.toggle-track::after{left:21px;background:var(--cy);}
.toggle-label{font-size:11px;font-family:var(--mono);color:var(--t2);}

/* SECURITY PAGE */
.sec-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1.2rem;}
.sec-card{background:var(--card);border:1px solid var(--b1);border-radius:var(--r);padding:1.3rem;}
.sec-card h3{font-size:12px;font-weight:600;font-family:var(--d);margin-bottom:1rem;display:flex;align-items:center;gap:8px;}
.threat-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--b1);}
.threat-row:last-child{border-bottom:none;}
.threat-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;}
.threat-icon.high{background:rgba(244,63,94,0.12);color:var(--rd);}
.threat-icon.med{background:rgba(251,191,36,0.1);color:var(--am);}
.threat-icon.low{background:rgba(56,189,248,0.1);color:var(--bl);}
.threat-info{flex:1;}
.threat-name{font-size:12.5px;font-weight:500;}
.threat-detail{font-size:11px;color:var(--t2);font-family:var(--mono);margin-top:2px;}
.threat-sev{font-size:10px;font-family:var(--mono);padding:2px 8px;border-radius:100px;}
.sev-high{background:rgba(244,63,94,0.1);color:var(--rd);border:1px solid rgba(244,63,94,0.25);}
.sev-med{background:rgba(251,191,36,0.1);color:var(--am);border:1px solid rgba(251,191,36,0.25);}
.sev-low{background:rgba(56,189,248,0.1);color:var(--bl);border:1px solid rgba(56,189,248,0.25);}
.audit-row{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid var(--b1);}
.audit-row:last-child{border-bottom:none;}
.audit-time{font-size:10px;font-family:var(--mono);color:var(--t3);flex-shrink:0;width:70px;}
.audit-text{font-size:12px;flex:1;}
.audit-user{font-size:11px;color:var(--pu);font-family:var(--mono);}
.audit-badge{font-size:9.5px;padding:2px 7px;border-radius:5px;font-family:var(--mono);}
.ab-green{background:rgba(16,185,129,0.1);color:var(--gr);}
.ab-red{background:rgba(244,63,94,0.1);color:var(--rd);}
.ab-am{background:rgba(251,191,36,0.1);color:var(--am);}

/* SETTINGS PAGE */
.settings-grid{display:grid;grid-template-columns:250px 1fr;gap:10px;align-items:start;}
.settings-nav{background:var(--card);border:1px solid var(--b1);border-radius:var(--r);padding:0.75rem;position:sticky;top:85px;}
.sn-item{display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:9px;font-size:13px;color:var(--t2);cursor:pointer;transition:all .15s;margin-bottom:2px;}
.sn-item:hover{background:rgba(124,80,255,0.07);color:var(--t1);}
.sn-item.active{background:rgba(124,80,255,0.14);color:var(--pu);}
.sn-item i{width:15px;text-align:center;font-size:12px;}
.settings-panel{background:var(--card);border:1px solid var(--b1);border-radius:var(--r);padding:1.5rem;}
.sp{display:none;}
.sp.active{display:block;animation:fadeIn .25s ease;}
.settings-section-title{font-size:15px;font-weight:700;font-family:var(--d);margin-bottom:1.3rem;padding-bottom:0.9rem;border-bottom:1px solid var(--b1);}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;}
.form-group{display:flex;flex-direction:column;gap:6px;}
.form-label{font-size:10.5px;color:var(--t2);text-transform:uppercase;letter-spacing:1px;font-family:var(--mono);}
.form-input{
  background:var(--bg2);border:1px solid var(--b2);border-radius:9px;
  padding:10px 13px;color:var(--t1);font-size:13px;outline:none;transition:all .2s;
}
.form-input:focus{border-color:var(--pu);box-shadow:0 0 12px rgba(124,80,255,0.15);}
.form-select{
  background:var(--bg2);border:1px solid var(--b2);border-radius:9px;
  padding:10px 13px;color:var(--t1);font-size:13px;outline:none;
  appearance:none;cursor:pointer;
}
.form-textarea{
  background:var(--bg2);border:1px solid var(--b2);border-radius:9px;
  padding:10px 13px;color:var(--t1);font-size:13px;outline:none;
  resize:vertical;min-height:80px;
}
.setting-row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--b1);}
.setting-row:last-child{border-bottom:none;}
.setting-info h4{font-size:13.5px;font-weight:500;}
.setting-info p{font-size:12px;color:var(--t2);margin-top:3px;}
.save-btn{
  display:inline-flex;align-items:center;gap:7px;
  background:linear-gradient(135deg,var(--pu),var(--pk));
  color:#fff;border:none;border-radius:10px;padding:10px 20px;
  font-size:13px;font-weight:600;font-family:var(--d);
  box-shadow:0 8px 25px rgba(124,80,255,0.3);transition:all .2s;margin-top:1rem;
}
.save-btn:hover{transform:translateY(-2px);box-shadow:0 12px 35px rgba(124,80,255,0.4);}
.danger-zone{background:rgba(244,63,94,0.05);border:1px solid rgba(244,63,94,0.2);border-radius:11px;padding:1rem;margin-top:1rem;}
.danger-zone h4{font-size:12px;font-weight:600;color:var(--rd);margin-bottom:8px;font-family:var(--mono);text-transform:uppercase;}
.dz-btn{
  display:inline-flex;align-items:center;gap:6px;
  background:none;border:1px solid rgba(244,63,94,0.3);color:var(--rd);
  border-radius:8px;padding:8px 14px;font-size:12px;font-family:var(--mono);transition:all .2s;
}
.dz-btn:hover{background:rgba(244,63,94,0.1);}

/* NOTIFICATIONS */
.notif-center{position:fixed;top:75px;right:20px;z-index:999;display:flex;flex-direction:column;gap:8px;pointer-events:none;}
.notif{
  background:var(--card);border:1px solid var(--b2);border-radius:11px;
  padding:12px 16px;font-size:13px;min-width:260px;max-width:320px;
  box-shadow:0 10px 40px rgba(0,0,0,0.5);pointer-events:all;
  animation:slideIn .3s ease;display:flex;align-items:center;gap:10px;
}
@keyframes slideIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:translateX(0)}}
.notif.success{border-color:rgba(16,185,129,0.3);}
.notif.error{border-color:rgba(244,63,94,0.3);}
.notif.info{border-color:rgba(124,80,255,0.3);}
.notif-icon{font-size:16px;flex-shrink:0;}
.notif.success .notif-icon{color:var(--gr);}
.notif.error .notif-icon{color:var(--rd);}
.notif.info .notif-icon{color:var(--pu);}

/* MODAL */
.modal-overlay{
  display:none;position:fixed;inset:0;z-index:500;
  background:rgba(0,0,0,0.7);backdrop-filter:blur(6px);
  align-items:center;justify-content:center;padding:1rem;
}
.modal-overlay.open{display:flex;}
.modal{
  background:var(--card);border:1px solid var(--b2);border-radius:var(--rl);
  padding:2rem;width:100%;max-width:440px;position:relative;
  box-shadow:0 30px 80px rgba(0,0,0,0.6);animation:fadeUp .3s ease;
}
.modal::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--pu),var(--pk),transparent);}
.modal h3{font-family:var(--d);font-size:17px;font-weight:700;margin-bottom:1rem;}
.modal-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:var(--t3);font-size:18px;padding:4px;}
.modal-close:hover{color:var(--t1);}
.modal-actions{display:flex;gap:10px;margin-top:1.5rem;justify-content:flex-end;}
.modal-btn{
  padding:9px 18px;border-radius:9px;font-size:13px;font-family:var(--mono);
  border:1px solid var(--b2);color:var(--t2);background:none;transition:all .2s;
}
.modal-btn:hover{border-color:var(--pu);color:var(--pu);}
.modal-btn.primary{background:linear-gradient(135deg,var(--pu),var(--pk));color:#fff;border:none;box-shadow:0 5px 20px rgba(124,80,255,0.3);}
.modal-btn.danger{background:rgba(244,63,94,0.1);border-color:var(--rd);color:var(--rd);}

/* RESPONSIVE */
@media(max-width:900px){
  .charts-row,.mid-row,.an-grid,.sec-grid,.settings-grid{grid-template-columns:1fr;}
  .form-row{grid-template-columns:1fr;}
}
@media(max-width:700px){
  .sidebar{transform:translateX(-100%);}
  .sidebar.open{transform:translateX(0);}
  .main,.topbar{margin-left:0;left:0;}
  .menu-toggle{display:flex;}
  .bots-grid{grid-template-columns:1fr;}
  .sec-grid{grid-template-columns:1fr;}
}
.menu-toggle{display:none;background:none;border:1px solid var(--b2);border-radius:8px;width:35px;height:35px;align-items:center;justify-content:center;color:var(--t2);font-size:15px;}
</style>
</head>
<body>

<!-- NOTIFICATIONS -->
<div class="notif-center" id="notif-center"></div>

<!-- MODAL -->
<div class="modal-overlay" id="modal-overlay">
  <div class="modal" id="modal-content">
    <button class="modal-close" onclick="closeModal()"><i class="fa fa-times"></i></button>
    <div id="modal-body"></div>
  </div>
</div>

<!-- LOGIN PAGE -->
<div id="login-page">
  <div class="login-box">
    <div class="lb-logo">
      <div class="lb-mark">Y</div>
      <h1>YUVORAI</h1>
      <div class="sub">ADMIN INTELLIGENCE HUB</div>
    </div>
    <div class="lb-card">
      <label class="field-label">Username</label>
      <input class="field-input" id="login-user" type="text" placeholder="admin@yuvorai.ai" autocomplete="off">
      <label class="field-label">Password</label>
      <input class="field-input" id="login-pass" type="password" placeholder="••••••••••••">
      <button class="login-btn" onclick="doLogin()"><i class="fa fa-bolt" style="margin-right:7px"></i>Access Dashboard</button>
      <div class="login-error" id="login-error"><i class="fa fa-triangle-exclamation"></i> Invalid credentials. Try admin / admin123</div>
    </div>
    <div class="login-hint">admin / admin123 &nbsp;•&nbsp; mod / mod123 &nbsp;•&nbsp; Any valid input</div>
  </div>
</div>

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
  <div class="sb-logo">
    <div class="logo-mark">Y</div>
    <div>
      <div class="logo-text">YUVORAI</div>
      <div class="logo-sub2">Admin Hub v2.0</div>
    </div>
  </div>
  <div class="nav-scroll">
    <div class="nav-sec">Core</div>
    <div class="ni active" onclick="navigate('dashboard',this)"><i class="fa fa-house"></i>Dashboard<span class="nbadge ok">Live</span></div>
    <div class="ni" onclick="navigate('analytics',this)"><i class="fa fa-chart-line"></i>Analytics</div>
    <div class="ni" onclick="navigate('users',this)"><i class="fa fa-users"></i>Users<span class="nbadge">247</span></div>
    <div class="nav-sec">AI System</div>
    <div class="ni" onclick="navigate('bots',this)"><i class="fa fa-robot"></i>Bot Management<span class="nbadge">6</span></div>
    <div class="ni" onclick="navigate('conversations',this)"><i class="fa fa-comments"></i>Conversations<span class="nbadge warn">12</span></div>
    <div class="nav-sec">System</div>
    <div class="ni" onclick="navigate('security',this)"><i class="fa fa-shield"></i>Security<span class="nbadge warn">3</span></div>
    <div class="ni" onclick="navigate('settings',this)"><i class="fa fa-gear"></i>Settings</div>
  </div>
  <div class="sb-foot">
    <div class="sb-user">
      <div class="av" id="user-av">A</div>
      <div>
        <div class="su-name" id="user-name">Admin</div>
        <div class="su-role" id="user-role">SUPER ADMIN</div>
      </div>
    </div>
  </div>
</aside>

<!-- TOPBAR -->
<div class="topbar" id="topbar" style="display:none">
  <div style="display:flex;align-items:center;gap:12px;">
    <button class="menu-toggle" onclick="toggleSidebar()"><i class="fa fa-bars"></i></button>
    <div class="page-title" id="page-title">Dashboard</div>
  </div>
  <div class="topbar-right">
    <div class="live-pill"><div class="pulse"></div><span id="live-time">--:--</span></div>
    <button class="tb-btn" onclick="showNotif('Data refreshed!','success')"><i class="fa fa-rotate"></i> Refresh</button>
    <button class="tb-btn" id="logout-btn" onclick="doLogout()"><i class="fa fa-right-from-bracket"></i> Logout</button>
  </div>
</div>

<!-- MAIN -->
<div class="main" id="main" style="display:none">

  <!-- DASHBOARD -->
  <div class="page active" id="page-dashboard">
    <div class="sec-hdr">Overview</div>
    <div class="stats-grid">
      <div class="sc pu"><div class="sc-icon"><i class="fa fa-users"></i></div><div class="sc-lbl">Total Users</div><div class="sc-val" id="stat-total-users">—</div><div class="sc-delta up"><i class="fa fa-arrow-up"></i> +12.4% this week</div></div>
      <div class="sc cy"><div class="sc-icon"><i class="fa fa-robot"></i></div><div class="sc-lbl">Premium Users</div><div class="sc-val" id="stat-premium">—</div><div class="sc-delta up"><i class="fa fa-arrow-up"></i> +2 since Monday</div></div>
      <div class="sc pk"><div class="sc-icon"><i class="fa fa-comments"></i></div><div class="sc-lbl">Messages Today</div><div class="sc-val" id="msg-count">8,329</div><div class="sc-delta up"><i class="fa fa-arrow-up"></i> +23.1% vs yesterday</div></div>
      <div class="sc gr"><div class="sc-icon"><i class="fa fa-rupee-sign"></i></div><div class="sc-lbl">Total Revenue</div><div class="sc-val" id="stat-revenue">—</div><div class="sc-delta up"><i class="fa fa-arrow-up"></i> +1.2% this month</div></div>
      <div class="sc am"><div class="sc-icon"><i class="fa fa-clock"></i></div><div class="sc-lbl">Avg Response</div><div class="sc-val">1.2s</div><div class="sc-delta up"><i class="fa fa-arrow-down"></i> -0.3s faster</div></div>
      <div class="sc rd"><div class="sc-icon"><i class="fa fa-clock"></i></div><div class="sc-lbl">Pending Payments</div><div class="sc-val" id="stat-pending">—</div><div class="sc-delta dn"><i class="fa fa-arrow-up"></i> +3 new today</div></div>
    </div>

    <div class="charts-row">
      <div class="cc">
        <div class="cc-title"><div class="dot dot-pu"></div>Message Volume — Last 7 Days</div>
        <div class="legend">
          <span><div class="lsq" style="background:var(--pu)"></div>Messages</span>
          <span><div class="lsq" style="background:var(--pk)"></div>Active Users</span>
        </div>
        <canvas id="mainChart" height="200"></canvas>
      </div>
      <div class="cc">
        <div class="cc-title"><div class="dot dot-pk"></div>User Roles</div>
        <div class="donut-wrap">
          <canvas id="donutChart" height="200"></canvas>
          <div class="donut-center"><div class="dc-big">2,471</div><div class="dc-sm">TOTAL</div></div>
        </div>
      </div>
    </div>

    <div class="mid-row">
      <div class="cc">
        <div class="cc-title"><div class="dot dot-cy"></div>Top Active Bots</div>
        <div class="fs"><div class="fl">Yuvora Main</div><div class="fb-wrap"><div class="fb" style="width:88%;background:linear-gradient(90deg,var(--pu),var(--pk))"></div></div><div class="fn">88%</div></div>
        <div class="fs"><div class="fl">StudyBot Pro</div><div class="fb-wrap"><div class="fb" style="width:72%;background:linear-gradient(90deg,var(--cy),var(--bl))"></div></div><div class="fn">72%</div></div>
        <div class="fs"><div class="fl">QuizMaster</div><div class="fb-wrap"><div class="fb" style="width:61%;background:linear-gradient(90deg,var(--pk),var(--am))"></div></div><div class="fn">61%</div></div>
        <div class="fs"><div class="fl">Career Guide</div><div class="fb-wrap"><div class="fb" style="width:45%;background:linear-gradient(90deg,var(--am),var(--gr))"></div></div><div class="fn">45%</div></div>
        <div class="fs"><div class="fl">Mental Buddy</div><div class="fb-wrap"><div class="fb" style="width:38%;background:linear-gradient(90deg,var(--gr),var(--cy))"></div></div><div class="fn">38%</div></div>
      </div>
      <div class="cc">
        <div class="cc-title"><div class="dot dot-gr"></div>System Health</div>
        <div class="fs"><div class="fl">API Uptime</div><div class="fb-wrap"><div class="fb" style="width:99.8%;background:var(--gr)"></div></div><div class="fn" style="color:var(--gr)">99.8%</div></div>
        <div class="fs"><div class="fl">CPU Usage</div><div class="fb-wrap"><div class="fb" style="width:34%;background:var(--cy)"></div></div><div class="fn">34%</div></div>
        <div class="fs"><div class="fl">RAM Usage</div><div class="fb-wrap"><div class="fb" style="width:58%;background:var(--am)"></div></div><div class="fn">58%</div></div>
        <div class="fs"><div class="fl">DB Load</div><div class="fb-wrap"><div class="fb" style="width:22%;background:var(--bl)"></div></div><div class="fn">22%</div></div>
        <div class="fs"><div class="fl">AI Model</div><div class="fb-wrap"><div class="fb" style="width:91%;background:var(--pu)"></div></div><div class="fn">91%</div></div>
      </div>
    </div>
  </div>

  <!-- ANALYTICS -->
  <div class="page" id="page-analytics">
    <div class="sec-hdr">Analytics Overview</div>
    <div class="an-grid">
      <div class="an-card">
        <h3><div class="dot dot-pu" style="width:6px;height:6px;border-radius:50%;background:var(--pu);display:inline-block"></div>Total Sessions</h3>
        <div class="metric-big">48,291</div>
        <div class="metric-sub"><span class="up">↑ 18.3%</span> vs last month</div>
      </div>
      <div class="an-card">
        <h3><div class="dot dot-cy" style="width:6px;height:6px;border-radius:50%;background:var(--cy);display:inline-block"></div>Avg Session Duration</h3>
        <div class="metric-big">14:32</div>
        <div class="metric-sub"><span class="up">↑ 2.1 min</span> improvement</div>
      </div>
      <div class="an-card">
        <h3><div class="dot dot-pk" style="width:6px;height:6px;border-radius:50%;background:var(--pk);display:inline-block"></div>Satisfaction Score</h3>
        <div class="metric-big">4.8/5</div>
        <div class="metric-sub"><span class="up">↑ 0.2</span> this quarter</div>
      </div>
    </div>

    <div class="charts-row">
      <div class="cc">
        <div class="cc-title"><div class="dot dot-pu"></div>Monthly User Growth</div>
        <canvas id="growthChart" height="200"></canvas>
      </div>
      <div class="cc">
        <div class="cc-title"><div class="dot dot-cy"></div>Traffic by Platform</div>
        <div class="donut-wrap">
          <canvas id="platformChart" height="200"></canvas>
          <div class="donut-center"><div class="dc-big">3</div><div class="dc-sm">PLATFORMS</div></div>
        </div>
      </div>
    </div>

    <div class="mid-row">
      <div class="cc">
        <div class="cc-title"><div class="dot dot-gr"></div>Activity Heatmap (This Week)</div>
        <div style="display:flex;gap:8px;font-size:9px;font-family:var(--mono);color:var(--t3);margin-bottom:5px;">
          <span style="flex:1;text-align:center">Mon</span><span style="flex:1;text-align:center">Tue</span><span style="flex:1;text-align:center">Wed</span><span style="flex:1;text-align:center">Thu</span><span style="flex:1;text-align:center">Fri</span><span style="flex:1;text-align:center">Sat</span><span style="flex:1;text-align:center">Sun</span>
        </div>
        <div class="heatmap" id="heatmap"></div>
      </div>
      <div class="cc">
        <div class="cc-title"><div class="dot dot-pk"></div>User Retention by Week</div>
        <div class="retention-bars">
          <div class="ret-bar"><div class="ret-label">Week 1</div><div class="ret-track"><div class="ret-fill" style="width:100%"></div></div><div class="ret-val">100%</div></div>
          <div class="ret-bar"><div class="ret-label">Week 2</div><div class="ret-track"><div class="ret-fill" style="width:72%"></div></div><div class="ret-val">72%</div></div>
          <div class="ret-bar"><div class="ret-label">Week 3</div><div class="ret-track"><div class="ret-fill" style="width:58%"></div></div><div class="ret-val">58%</div></div>
          <div class="ret-bar"><div class="ret-label">Week 4</div><div class="ret-track"><div class="ret-fill" style="width:49%"></div></div><div class="ret-val">49%</div></div>
          <div class="ret-bar"><div class="ret-label">Week 8</div><div class="ret-track"><div class="ret-fill" style="width:38%"></div></div><div class="ret-val">38%</div></div>
          <div class="ret-bar"><div class="ret-label">Week 12</div><div class="ret-track"><div class="ret-fill" style="width:29%"></div></div><div class="ret-val">29%</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- USERS -->
  <div class="page" id="page-users">
    <div class="sec-hdr">User Management</div>
    <div class="tc">
      <div class="tc-head">
        <div class="tc-title"><i class="fa fa-users" style="color:var(--pu)"></i> All Users</div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <div class="search-wrap"><i class="fa fa-search"></i><input type="text" id="user-search" placeholder="Search users..." oninput="filterUsers()"></div>
          <button class="tb-btn" onclick="showAddUser()"><i class="fa fa-plus"></i> Add User</button>
        </div>
      </div>
      <div class="filter-row">
        <button class="pill active" onclick="filterByRole('all',this)">All Users</button>
        <button class="pill" onclick="filterByRole('admin',this)">Admins</button>
        <button class="pill" onclick="filterByRole('mod',this)">Moderators</button>
        <button class="pill" onclick="filterByRole('student',this)">Students</button>
        <button class="pill" onclick="filterByRole('active',this)">Active</button>
        <button class="pill" onclick="filterByRole('inactive',this)">Inactive</button>
      </div>
      <div class="tbl-wrap">
        <table><thead><tr>
          <th>User</th><th>Role</th><th>Status</th><th>Messages</th><th>Engagement</th><th>Joined</th><th>Actions</th>
        </tr></thead>
        <tbody id="users-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- BOT MANAGEMENT -->
  <div class="page" id="page-bots">
    <div class="sec-hdr">Bot Management</div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:10px;">
      <div style="font-size:12px;color:var(--t2);font-family:var(--mono);">6 bots deployed • 4 active • 1 paused • 1 offline</div>
      <button class="tb-btn" onclick="showAddBot()"><i class="fa fa-plus"></i> Deploy New Bot</button>
    </div>
    <div class="bots-grid" id="bots-grid"></div>
  </div>

  <!-- CONVERSATIONS -->
  <div class="page" id="page-conversations">
    <div class="sec-hdr">Conversation Monitor</div>
    <div class="tc">
      <div class="tc-head">
        <div class="tc-title"><i class="fa fa-comments" style="color:var(--pk)"></i> Recent Conversations</div>
        <div style="display:flex;gap:8px;">
          <div class="search-wrap"><i class="fa fa-search"></i><input type="text" placeholder="Search conversations..."></div>
          <button class="tb-btn" onclick="showNotif('Conversations exported!','success')"><i class="fa fa-download"></i> Export</button>
        </div>
      </div>
      <div class="filter-row">
        <button class="pill active">All</button>
        <button class="pill" onclick="this.parentNode.querySelectorAll('.pill').forEach(p=>p.classList.remove('active'));this.classList.add('active')">Flagged</button>
        <button class="pill" onclick="this.parentNode.querySelectorAll('.pill').forEach(p=>p.classList.remove('active'));this.classList.add('active')">Resolved</button>
        <button class="pill" onclick="this.parentNode.querySelectorAll('.pill').forEach(p=>p.classList.remove('active'));this.classList.add('active')">Ongoing</button>
      </div>
      <div class="tbl-wrap">
        <table><thead><tr><th>User</th><th>Bot</th><th>Last Message</th><th>Messages</th><th>Status</th><th>Time</th><th>Actions</th></tr></thead>
        <tbody id="conv-tbody"></tbody></table>
      </div>
    </div>
  </div>

  <!-- SECURITY -->
  <div class="page" id="page-security">
    <div class="sec-hdr">Security Center</div>
    <div class="stats-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:1.2rem;">
      <div class="sc gr"><div class="sc-icon"><i class="fa fa-shield-check"></i></div><div class="sc-lbl">Threats Blocked</div><div class="sc-val">1,247</div><div class="sc-delta up">This month</div></div>
      <div class="sc rd"><div class="sc-icon"><i class="fa fa-triangle-exclamation"></i></div><div class="sc-lbl">Active Alerts</div><div class="sc-val">3</div><div class="sc-delta dn">Needs attention</div></div>
      <div class="sc am"><div class="sc-icon"><i class="fa fa-user-slash"></i></div><div class="sc-lbl">Banned Users</div><div class="sc-val">18</div><div class="sc-delta">Total banned</div></div>
      <div class="sc bl"><div class="sc-icon"><i class="fa fa-lock"></i></div><div class="sc-lbl">2FA Enabled</div><div class="sc-val">84%</div><div class="sc-delta up">Users secured</div></div>
    </div>
    <div class="sec-grid">
      <div class="sec-card">
        <h3><i class="fa fa-triangle-exclamation" style="color:var(--rd)"></i> Active Threats</h3>
