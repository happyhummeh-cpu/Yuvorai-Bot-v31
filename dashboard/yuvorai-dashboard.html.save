  {user:'Sanya Gupta',bot:'StudyBot Pro',last:'Help with English essay writing',msgs:31,status:'active',time:'31m ago'},
  {user:'Priya Sharma',bot:'Code Sensei',last:'Python list comprehension examples',msgs:62,status:'resolved',time:'1h ago'},
  {user:'Ananya Singh',bot:'Career Guide',last:'Should I choose CS or MBA?',msgs:18,status:'flagged',time:'2h ago'},
];

let currentUser = null;
let activeRoleFilter = 'all';
let chartInstances = {};

// ═══════════════════════ AUTH ═══════════════════════
// ── API CONFIG — apna server URL yahan daalo ──────────────────────────────────
const API_BASE = 'http://3.110.128.143:3000/api';

async function api(path, options = {}) {
  const res = await fetch(API_BASE + path, {
    ...options,
    headers: { 'Content-Type': 'application/json', 'x-admin-token': API_TOKEN, ...(options.headers || {}) },
  });
  if (!res.ok) throw new Error(await res.text());
  return res.json();
}

async function doLogin() {
  const u = document.getElementById('login-user').value.trim();
  const p = document.getElementById('login-pass').value;
  const err = document.getElementById('login-error');
  if (!p) { err.style.display = 'block'; err.textContent = 'Password required'; return; }
  try {
    const res = await api('/login', { method: 'POST', body: JSON.stringify({ password: p }) });
    if (res.success) {
      API_TOKEN = res.token;
      const name = u || 'Admin';
      currentUser = { name, role: 'ADMIN' };
      document.getElementById('user-name').textContent = name;
      document.getElementById('user-role').textContent = 'ADMIN';
      document.getElementById('user-av').textContent = name[0].toUpperCase();
      document.getElementById('login-page').style.display = 'none';
      document.getElementById('topbar').style.display = 'flex';
      document.getElementById('main').style.display = 'block';
      err.style.display = 'none';
      initDashboard();
      startClock();
      showNotif('Welcome back! 👋 Live data loading...', 'success');
    } else {
      err.style.display = 'block'; err.textContent = 'Wrong password!';
    }
  } catch(e) {
    err.style.display = 'block';
    err.textContent = 'Server se connect nahi hua — check karo API URL!';
    console.error('Login failed:', e);
  }
}

function doLogout() {
  document.getElementById('login-page').style.display = 'flex';
  document.getElementById('topbar').style.display = 'none';
  document.getElementById('main').style.display = 'none';
  document.getElementById('login-user').value = '';
  document.getElementById('login-pass').value = '';
  Object.values(chartInstances).forEach(c => c.destroy && c.destroy());
  chartInstances = {};
  showNotif('Logged out successfully','info');
}

// ═══════════════════════ NAVIGATION ═══════════════════════
const pageTitles = {
  dashboard:'Dashboard',analytics:'Analytics',users:'User Management',
  bots:'Bot Management',conversations:'Conversation Monitor',
  security:'Security Center',settings:'System Settings'
};

function navigate(page, el) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  document.getElementById('page-'+page).classList.add('active');
  el.classList.add('active');
  document.getElementById('page-title').textContent = pageTitles[page];
  
  if(page === 'analytics') initAnalyticsCharts();
  if(page === 'users') renderUsers();
  if(page === 'bots') renderBots();
  if(page === 'conversations') renderConversations();
  if(page === 'security') initSecurityChart();
}

// ═══════════════════════ CLOCK ═══════════════════════
function startClock() {
  const tick = () => {
    const now = new Date();
    document.getElementById('live-time').textContent = now.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  };
  tick(); setInterval(tick, 1000);
  // Animate msg count
  setInterval(() => {
    const el = document.getElementById('msg-count');
    if(el) { const v = parseInt(el.textContent.replace(',',''))+Math.floor(Math.random()*3); el.textContent = v.toLocaleString(); }
  }, 3000);
}

// ═══════════════════════ DASHBOARD CHARTS ═══════════════════════
function initDashboard() {
  renderUsers(); renderBots(); renderConversations();
  loadLiveStats();
  loadLiveChartData();
  // Refresh stats every 30 seconds
  setInterval(loadLiveStats, 30000);
  
  // Main chart
  const ctx = document.getElementById('mainChart').getContext('2d');
  chartInstances.main = new Chart(ctx, {
    type:'line',
    data:{
      labels:['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
      datasets:[
        {label:'Messages',data:[5240,6830,7210,6940,8329,9120,8750],borderColor:'#7c50ff',backgroundColor:'rgba(124,80,255,0.08)',fill:true,tension:0.4,borderWidth:2,pointBackgroundColor:'#7c50ff',pointRadius:4},
        {label:'Active Users',data:[420,580,610,540,720,810,760],borderColor:'#e879f9',backgroundColor:'rgba(232,121,249,0.06)',fill:true,tension:0.4,borderWidth:2,pointBackgroundColor:'#e879f9',pointRadius:4}
      ]
    },
    options:{
      responsive:true,maintainAspectRatio:true,
      plugins:{legend:{display:false},tooltip:{backgroundColor:'#13132a',titleColor:'#ede9ff',bodyColor:'#8878bb',borderColor:'rgba(124,80,255,0.2)',borderWidth:1}},
      scales:{
        x:{grid:{color:'rgba(124,80,255,0.06)'},ticks:{color:'#8878bb',font:{size:11}}},
        y:{grid:{color:'rgba(124,80,255,0.06)'},ticks:{color:'#8878bb',font:{size:11}}}
      }
    }
  });

  // Donut chart
  const ctx2 = document.getElementById('donutChart').getContext('2d');
  chartInstances.donut = new Chart(ctx2, {
    type:'doughnut',
    data:{
      labels:['Students','Moderators','Admins'],
      datasets:[{data:[2198,198,75],backgroundColor:['#7c50ff','#e879f9','#06d6a0'],borderColor:'transparent',borderWidth:0}]
    },
    options:{
      cutout:'72%',responsive:true,maintainAspectRatio:true,
      plugins:{legend:{display:false},tooltip:{backgroundColor:'#13132a',titleColor:'#ede9ff',bodyColor:'#8878bb'}}
    }
  });
}

// ═══════════════════════ ANALYTICS CHARTS ═══════════════════════
function initAnalyticsCharts() {
  if(chartInstances.growth) { chartInstances.growth.destroy(); chartInstances.platform?.destroy(); }
  
  const months = ['Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar','Apr','May'];
  const ctx3 = document.getElementById('growthChart').getContext('2d');
  chartInstances.growth = new Chart(ctx3, {
    type:'bar',
    data:{
      labels:months,
      datasets:[
        {label:'New Users',data:[89,124,198,267,412,580,734,891,1102,1247],backgroundColor:'rgba(124,80,255,0.7)',borderRadius:5},
        {label:'Active Users',data:[67,98,156,210,340,490,620,750,920,1100],backgroundColor:'rgba(232,121,249,0.5)',borderRadius:5}
      ]
    },
    options:{
      responsive:true,maintainAspectRatio:true,
      plugins:{legend:{labels:{color:'#8878bb',font:{size:11}}},tooltip:{backgroundColor:'#13132a',titleColor:'#ede9ff',bodyColor:'#8878bb'}},
      scales:{
        x:{grid:{color:'rgba(124,80,255,0.06)'},ticks:{color:'#8878bb',font:{size:11}}},
        y:{grid:{color:'rgba(124,80,255,0.06)'},ticks:{color:'#8878bb',font:{size:11}}}
      }
    }
  });

  const ctx4 = document.getElementById('platformChart').getContext('2d');
  chartInstances.platform = new Chart(ctx4, {
    type:'doughnut',
    data:{
      labels:['Web','Android','iOS'],
      datasets:[{data:[58,28,14],backgroundColor:['#7c50ff','#06d6a0','#e879f9'],borderColor:'transparent',borderWidth:0}]
    },
    options:{
      cutout:'72%',responsive:true,
      plugins:{legend:{position:'bottom',labels:{color:'#8878bb',font:{size:11},padding:15}},tooltip:{backgroundColor:'#13132a'}}
    }
  });

  // Heatmap
  const hm = document.getElementById('heatmap');
  if(hm && !hm.dataset.built) {
    hm.dataset.built = '1';
    for(let i=0;i<28;i++){
      const cell = document.createElement('div');
      cell.className = 'hm-cell';
      const v = Math.random();
      if(v > 0.85) cell.style.background = '#7c50ff';
      else if(v > 0.65) cell.style.background = 'rgba(124,80,255,0.55)';
      else if(v > 0.4) cell.style.background = 'rgba(124,80,255,0.3)';
      else if(v > 0.2) cell.style.background = 'rgba(124,80,255,0.15)';
      cell.title = `${Math.floor(v*200)} sessions`;
      hm.appendChild(cell);
    }
  }
}

// ═══════════════════════ SECURITY CHART ═══════════════════════
function initSecurityChart() {
  if(chartInstances.security) chartInstances.security.destroy();
  const ctx = document.getElementById('securityChart').getContext('2d');
  const days = Array.from({length:30},(_,i)=>`Day ${i+1}`);
  const threats = Array.from({length:30},()=>Math.floor(Math.random()*80+10));
  const blocked = threats.map(t=>Math.floor(t*0.92));
  chartInstances.security = new Chart(ctx, {
    type:'line',
    data:{
      labels:days,
      datasets:[
        {label:'Threats Detected',data:threats,borderColor:'#f43f5e',backgroundColor:'rgba(244,63,94,0.06)',fill:true,tension:0.4,borderWidth:2,pointRadius:0},
        {label:'Threats Blocked',data:blocked,borderColor:'#06d6a0',backgroundColor:'rgba(6,214,160,0.06)',fill:true,tension:0.4,borderWidth:2,pointRadius:0}
      ]
    },
    options:{
      responsive:true,maintainAspectRatio:true,
      plugins:{legend:{labels:{color:'#8878bb',font:{size:11}}},tooltip:{backgroundColor:'#13132a',titleColor:'#ede9ff',bodyColor:'#8878bb'}},
      scales:{
        x:{grid:{color:'rgba(124,80,255,0.05)'},ticks:{color:'#8878bb',font:{size:10},maxTicksLimit:10}},
        y:{grid:{color:'rgba(124,80,255,0.05)'},ticks:{color:'#8878bb',font:{size:10}}}
      }
    }
  });
}

// ═══════════════════════ USERS ═══════════════════════
function renderUsers(filter='', roleFilter=activeRoleFilter) {
  const tbody = document.getElementById('users-tbody');
  let filtered = USERS.filter(u => {
    const matchSearch = !filter || u.name.toLowerCase().includes(filter) || u.email.toLowerCase().includes(filter);
    const matchRole = roleFilter === 'all' || u.role === roleFilter || u.status === roleFilter;
    return matchSearch && matchRole;
  });
  const engage = {2341:100,1247:53,893:38,789:34,445:19,334:14,112:5,67:3};
  tbody.innerHTML = filtered.map(u => `
    <tr>
      <td><div class="uc">
        <div class="av-sm" style="background:${u.color}22;color:${u.color};border:1px solid ${u.color}44">${u.name[0]}</div>
        <div><div class="u-name">${u.name}</div><div class="u-email">${u.email}</div></div>
      </div></td>
      <td><span class="role-badge role-${u.role}">${u.role}</span></td>
      <td><span class="badge b-${u.status}"><span style="width:5px;height:5px;border-radius:50%;background:currentColor;display:inline-block"></span>${u.status}</span></td>
      <td style="font-family:var(--mono);font-size:12px">${u.msgs.toLocaleString()}</td>
      <td><div class="pb"><div class="pf" style="width:${engage[u.msgs]||10}%;background:${u.color}"></div></div></td>
      <td style="font-family:var(--mono);font-size:11px;color:var(--t2)">${u.joined}</td>
      <td><div class="action-btns">
        <button class="action-btn" onclick="showUserModal(${u.id})"><i class="fa fa-eye"></i></button>
        <button class="action-btn" onclick="showNotif('User edited!','success')"><i class="fa fa-pencil"></i></button>
        <button class="action-btn del" onclick="showNotif('User banned!','error')"><i class="fa fa-ban"></i></button>
      </div></td>
    </tr>
  `).join('');
}

function filterUsers() {
  renderUsers(document.getElementById('user-search').value.toLowerCase());
}

function filterByRole(role, el) {
  activeRoleFilter = role;
  document.querySelectorAll('.filter-row .pill').forEach(p=>p.classList.remove('active'));
  el.classList.add('active');
  renderUsers(document.getElementById('user-search')?.value.toLowerCase()||'');
}

function showUserModal(id) {
  const u = USERS.find(x=>x.id===id);
  document.getElementById('modal-body').innerHTML = `
    <h3><i class="fa fa-user" style="color:var(--pu);margin-right:8px"></i>User Profile</h3>
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:1.2rem;padding:1rem;background:var(--bg3);border-radius:11px;">
      <div style="width:48px;height:48px;border-radius:50%;background:${u.color}22;color:${u.color};border:1px solid ${u.color}44;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;font-family:var(--d);flex-shrink:0">${u.name[0]}</div>
      <div><div style="font-size:15px;font-weight:600">${u.name}</div><div style="font-size:12px;color:var(--t2);font-family:var(--mono)">${u.email}</div></div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;font-family:var(--mono);font-size:12px;">
      <div style="background:var(--bg3);padding:10px;border-radius:9px"><div style="color:var(--t3);font-size:10px;margin-bottom:4px">ROLE</div><span class="role-badge role-${u.role}">${u.role}</span></div>
      <div style="background:var(--bg3);padding:10px;border-radius:9px"><div style="color:var(--t3);font-size:10px;margin-bottom:4px">STATUS</div><span class="badge b-${u.status}">${u.status}</span></div>
      <div style="background:var(--bg3);padding:10px;border-radius:9px"><div style="color:var(--t3);font-size:10px;margin-bottom:4px">MESSAGES</div><div style="font-size:18px;font-weight:700;color:var(--pu)">${u.msgs.toLocaleString()}</div></div>
      <div style="background:var(--bg3);padding:10px;border-radius:9px"><div style="color:var(--t3);font-size:10px;margin-bottom:4px">JOINED</div><div style="color:var(--t1)">${u.joined}</div></div>
    </div>
    <div class="modal-actions">
      <button class="modal-btn" onclick="closeModal()">Close</button>
      <button class="modal-btn primary" onclick="closeModal();showNotif('User updated!','success')"><i class="fa fa-check"></i> Save Changes</button>
    </div>
  `;
  openModal();
}

function showAddUser() {
  document.getElementById('modal-body').innerHTML = `
    <h3><i class="fa fa-user-plus" style="color:var(--cy);margin-right:8px"></i>Add New User</h3>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">Full Name</div><input class="form-input" placeholder="Enter full name"></div>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">Email</div><input class="form-input" type="email" placeholder="user@example.com"></div>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">Role</div><select class="form-select"><option>student</option><option>mod</option><option>admin</option></select></div>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">Password</div><input class="form-input" type="password" placeholder="Set initial password"></div>
    <div class="modal-actions">
      <button class="modal-btn" onclick="closeModal()">Cancel</button>
      <button class="modal-btn primary" onclick="closeModal();showNotif('User created successfully!','success')"><i class="fa fa-plus"></i> Create User</button>
    </div>
  `;
  openModal();
}

// ═══════════════════════ BOTS ═══════════════════════
function renderBots() {
  const grid = document.getElementById('bots-grid');
  grid.innerHTML = BOTS.map(b => `
    <div class="bot-card ${b.status}-bot" id="bot-card-${b.id}">
      <div class="bot-header">
        <div class="bot-avatar ${b.color}">${b.icon}</div>
        <div>
          <div class="bot-name">${b.name}</div>
          <div class="bot-type">${b.type}</div>
        </div>
        <div class="bot-status-badge">
          <span class="badge ${b.status==='active'?'b-active':b.status==='paused'?'b-pending':'b-inactive'}">
            <span style="width:5px;height:5px;border-radius:50%;background:currentColor;display:inline-block"></span>
            ${b.status}
          </span>
        </div>
      </div>
      <div class="bot-stats">
        <div class="bs"><div class="bs-lbl">Total Msgs</div><div class="bs-val">${(b.msgs/1000).toFixed(1)}k</div></div>
        <div class="bs"><div class="bs-lbl">Accuracy</div><div class="bs-val">${b.accuracy}%</div></div>
        <div class="bs"><div class="bs-lbl">Uptime</div><div class="bs-val">${b.uptime}</div></div>
        <div class="bs"><div class="bs-lbl">Active Users</div><div class="bs-val">${b.users}</div></div>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
        <span style="font-size:11px;font-family:var(--mono);color:var(--t2)">Auto-restart on crash</span>
        <label class="toggle-switch">
          <input type="checkbox" class="toggle-input" ${b.status==='active'?'checked':''} onchange="toggleBot(${b.id},this)">
          <div class="toggle-track"></div>
        </label>
      </div>
      <div class="bot-actions">
        <button class="bot-btn primary" onclick="showBotConfig(${b.id})"><i class="fa fa-gear"></i> Config</button>
        <button class="bot-btn" onclick="restartBot(${b.id})"><i class="fa fa-rotate"></i> Restart</button>
        <button class="bot-btn danger" onclick="showConfirm('Delete ${b.name}?','This bot will be permanently removed.','deleteBot_${b.id}')"><i class="fa fa-trash"></i></button>
      </div>
    </div>
  `).join('');
}

function toggleBot(id, el) {
  const bot = BOTS.find(b=>b.id===id);
  bot.status = el.checked ? 'active' : 'paused';
  const card = document.getElementById('bot-card-'+id);
  if(card) {
    card.className = `bot-card ${bot.status}-bot`;
    card.querySelector('.badge').className = `badge ${bot.status==='active'?'b-active':'b-pending'}`;
    card.querySelector('.badge').innerHTML = `<span style="width:5px;height:5px;border-radius:50%;background:currentColor;display:inline-block"></span>${bot.status}`;
  }
  showNotif(`${bot.name} ${bot.status==='active'?'activated':'paused'}!`, bot.status==='active'?'success':'info');
}

function restartBot(id) {
  const bot = BOTS.find(b=>b.id===id);
  showNotif(`${bot.name} restarting...`,'info');
  setTimeout(()=>showNotif(`${bot.name} is online!`,'success'),2000);
}

function showBotConfig(id) {
  const bot = BOTS.find(b=>b.id===id);
  document.getElementById('modal-body').innerHTML = `
    <h3><i class="fa fa-gear" style="color:var(--pu);margin-right:8px"></i>Configure ${bot.name}</h3>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">Bot Name</div><input class="form-input" value="${bot.name}"></div>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">Bot Type</div><input class="form-input" value="${bot.type}"></div>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">System Prompt</div><textarea class="form-textarea">You are ${bot.name}, a ${bot.type} for YUVORAI students.</textarea></div>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">Max Concurrent Users</div><input class="form-input" type="number" value="500"></div>
    <div class="modal-actions">
      <button class="modal-btn" onclick="closeModal()">Cancel</button>
      <button class="modal-btn primary" onclick="closeModal();showNotif('${bot.name} config saved!','success')"><i class="fa fa-check"></i> Save Config</button>
    </div>
  `;
  openModal();
}

function showAddBot() {
  document.getElementById('modal-body').innerHTML = `
    <h3><i class="fa fa-robot" style="color:var(--cy);margin-right:8px"></i>Deploy New Bot</h3>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">Bot Name</div><input class="form-input" placeholder="e.g. MathHelper Pro"></div>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">Bot Type</div><select class="form-select"><option>General Assistant</option><option>Academic Tutor</option><option>Assessment Engine</option><option>Career Counselor</option><option>Wellness Support</option><option>Programming Tutor</option></select></div>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">System Prompt</div><textarea class="form-textarea" placeholder="You are..."></textarea></div>
    <div class="form-group" style="margin-bottom:12px"><div class="form-label">AI Model</div><select class="form-select"><option>GPT-4o</option><option>Claude 3.5</option><option>Gemini Pro</option></select></div>
    <div class="modal-actions">
      <button class="modal-btn" onclick="closeModal()">Cancel</button>
      <button class="modal-btn primary" onclick="closeModal();showNotif('New bot deployed!','success')"><i class="fa fa-rocket"></i> Deploy Bot</button>
    </div>
  `;
  openModal();
}

// ═══════════════════════ CONVERSATIONS ═══════════════════════
function renderConversations() {
  const tbody = document.getElementById('conv-tbody');
  tbody.innerHTML = CONVERSATIONS.map(c => `
    <tr>
      <td style="font-weight:500">${c.user}</td>
      <td><span style="font-family:var(--mono);font-size:11px;color:var(--pu)">${c.bot}</span></td>
      <td style="font-size:12px;color:var(--t2);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${c.last}</td>
      <td style="font-family:var(--mono);font-size:12px">${c.msgs}</td>
      <td><span class="badge ${c.status==='active'?'b-active':c.status==='flagged'?'b-inactive':'b-pending'}">${c.status}</span></td>
      <td style="font-family:var(--mono);font-size:11px;color:var(--t2)">${c.time}</td>
      <td><div class="action-btns">
        <button class="action-btn" onclick="showNotif('Opening conversation...','info')"><i class="fa fa-eye"></i></button>
        ${c.status==='flagged'?`<button class="action-btn" onclick="showNotif('Conversation flagged for review!','error')"><i class="fa fa-flag"></i></button>`:''}
        <button class="action-btn" onclick="showNotif('Conversation resolved!','success')"><i class="fa fa-check"></i></button>
      </div></td>
    </tr>
  `).join('');
}

// ═══════════════════════ SETTINGS ═══════════════════════
function switchSettings(id, el) {
  document.querySelectorAll('.sp').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.sn-item').forEach(i=>i.classList.remove('active'));
  document.getElementById('sp-'+id).classList.add('active');
  el.classList.add('active');
}

// ═══════════════════════ MODAL ═══════════════════════
function openModal() { document.getElementById('modal-overlay').classList.add('open'); }
function closeModal() { document.getElementById('modal-overlay').classList.remove('open'); }
document.getElementById('modal-overlay').addEventListener('click', e => { if(e.target===e.currentTarget) closeModal(); });

function showConfirm(title, msg, action) {
  document.getElementById('modal-body').innerHTML = `
    <h3 style="color:var(--rd)"><i class="fa fa-triangle-exclamation" style="margin-right:8px"></i>${title}</h3>
    <p style="font-size:13px;color:var(--t2);margin-bottom:0.5rem">${msg}</p>
    <div class="modal-actions">
      <button class="modal-btn" onclick="closeModal()">Cancel</button>
      <button class="modal-btn danger" onclick="closeModal();handleAction('${action}')"><i class="fa fa-check"></i> Confirm</button>
    </div>
  `;
  openModal();
}

function handleAction(action) {
  if(action==='clearConversations') { CONVERSATIONS.length=0; renderConversations(); showNotif('All conversations cleared','error'); }
  else if(action==='resetBots') showNotif('All bots reset to defaults','info');
  else if(action==='deletePlatform') showNotif('Action blocked for demo','error');
  else if(action.startsWith('deleteBot_')) {
    const id = parseInt(action.split('_')[1]);
    const idx = BOTS.findIndex(b=>b.id===id);
    if(idx>-1){BOTS.splice(idx,1);renderBots();showNotif('Bot removed','error');}
  }
}

// ═══════════════════════ NOTIFICATIONS ═══════════════════════
function showNotif(msg, type='info') {
  const icons = {success:'fa-check-circle',error:'fa-times-circle',info:'fa-circle-info'};
  const center = document.getElementById('notif-center');
  const n = document.createElement('div');
  n.className = `notif ${type}`;
  n.innerHTML = `<i class="fa ${icons[type]||icons.info} notif-icon"></i><span>${msg}</span>`;
  center.appendChild(n);
  setTimeout(()=>{ n.style.opacity='0'; n.style.transition='opacity .3s'; setTimeout(()=>n.remove(),300); }, 3000);
}

// ═══════════════════════ SIDEBAR MOBILE ═══════════════════════
function toggleSidebar() { document.getElementById('sidebar').classList.toggle('open'); }

// Enter key login
document.getElementById('login-pass').addEventListener('keydown', e => { if(e.key==='Enter') doLogin(); });
document.getElementById('login-user').addEventListener('keydown', e => { if(e.key==='Enter') doLogin(); });

// ══════════════════════════════════════════════════════════════
// ─── LIVE API FUNCTIONS ────────────────────────────────────────
// ══════════════════════════════════════════════════════════════

async function loadLiveStats() {
  try {
    const data = await api('/stats');
    // Update stat cards
    const el = (id) => document.getElementById(id);
    if(el('stat-total-users')) el('stat-total-users').textContent = (data.users?.total || 0).toLocaleString();
    if(el('stat-premium'))     el('stat-premium').textContent     = (data.users?.premium || 0).toLocaleString();
    if(el('stat-revenue'))     el('stat-revenue').textContent     = '₹' + (data.revenue?.total || 0).toLocaleString();
    if(el('stat-pending'))     el('stat-pending').textContent     = (data.payments?.pending || 0);
    if(el('msg-count'))        el('msg-count').textContent        = (data.users?.total || 0).toLocaleString();
    // Bot status
    const bs = await api('/bot-status');
    showNotif(`Bot: ${bs.bot} | DB: ${bs.database} | RAM: ${bs.memory}MB`, 'info');
  } catch(e) { console.warn('Stats load failed:', e.message); }
}

async function loadLiveChartData() {
  try {
    const data = await api('/analytics');
    const labels  = data.days.map(d => d.date);
    const users   = data.days.map(d => d.users);
    const revenue = data.days.map(d => d.revenue);
    // Update main chart if exists
    if(chartInstances.main) {
      chartInstances.main.data.labels = labels;
      chartInstances.main.data.datasets[0].data = users;
      chartInstances.main.data.datasets[1].data = revenue;
      chartInstances.main.update();
    }
    // Update donut with branch distribution
    if(chartInstances.donut && data.branches?.length) {
      chartInstances.donut.data.labels   = data.branches.map(b => b._id);
      chartInstances.donut.data.datasets[0].data = data.branches.map(b => b.count);
      chartInstances.donut.update();
    }
  } catch(e) { console.warn('Chart data failed:', e.message); }
}

async function renderUsers() {
  try {
    const data  = await api('/users?limit=20');
    const tbody = document.getElementById('user-tbody');
    if (!tbody || !data.users) return;
    tbody.innerHTML = data.users.map(u => {
      const planColors = {free:'b-pending', trial:'b-active', pro:'b-active', elite:'b-active', advanced:'b-active'};
      const initial    = (u.firstName || '?')[0].toUpperCase();
      const planExpiry = u.planExpiry ? new Date(u.planExpiry).toLocaleDateString('en-IN') : '—';
      return `<tr>
        <td>
          <div style="display:flex;align-items:center;gap:10px">
            <div style="width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#7c50ff,#e879f9);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;flex-shrink:0">${initial}</div>
            <div>
              <div style="font-weight:500;font-size:13px">${u.firstName || 'User'}</div>
              <div style="font-size:11px;color:var(--t2);font-family:var(--mono)">@${u.username || u.telegramId}</div>
            </div>
          </div>
        </td>
        <td style="font-family:var(--mono);font-size:11px;color:var(--t2)">${u.branch || '—'} ${u.year || ''}</td>
        <td><span class="badge ${planColors[u.plan] || 'b-pending'}">${u.plan}</span></td>
        <td style="font-family:var(--mono);font-size:12px">🔥 ${u.streak || 0}d &nbsp; ⚡${u.xp || 0}</td>
        <td style="font-family:var(--mono);font-size:11px;color:var(--t2)">${new Date(u.createdAt).toLocaleDateString('en-IN')}</td>
        <td><div class="action-btns">
          <button class="action-btn" onclick="viewUser('${u.telegramId}')"><i class="fa fa-eye"></i></button>
        </div></td>
      </tr>`;
    }).join('');
  } catch(e) { console.warn('Users load failed:', e.message); }
}

async function viewUser(id) {
  try {
    const u = await api(`/users/${id}`);
    document.getElementById('modal-body').innerHTML = `
      <h3><i class="fa fa-user" style="color:var(--pu);margin-right:8px"></i>${u.firstName}</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px;font-size:13px">
        <div><b style="color:var(--t2)">Telegram ID</b><br>${u.telegramId}</div>
        <div><b style="color:var(--t2)">Username</b><br>@${u.username || '—'}</div>
        <div><b style="color:var(--t2)">Branch</b><br>${u.branch || '—'} ${u.year || ''}</div>
        <div><b style="color:var(--t2)">Goal</b><br>${u.goal || '—'}</div>
        <div><b style="color:var(--t2)">Plan</b><br>${u.plan}</div>
        <div><b style="color:var(--t2)">Plan Expiry</b><br>${u.planExpiry ? new Date(u.planExpiry).toLocaleDateString('en-IN') : '—'}</div>
        <div><b style="color:var(--t2)">XP</b><br>⚡ ${u.xp || 0}</div>
        <div><b style="color:var(--t2)">Streak</b><br>🔥 ${u.streak || 0} days</div>
        <div><b style="color:var(--t2)">Identity</b><br>${u.identity || '—'}</div>
        <div><b style="color:var(--t2)">Referrals</b><br>${u.referralCount || 0}</div>
        <div><b style="color:var(--t2)">Joined</b><br>${new Date(u.createdAt).toLocaleDateString('en-IN')}</div>
        <div><b style="color:var(--t2)">Onboarded</b><br>${u.onboardingDone ? '✅ Yes' : '❌ No'}</div>
      </div>
      <div class="modal-actions" style="margin-top:16px">
        <button class="modal-btn" onclick="closeModal()">Close</button>
      </div>`;
    openModal();
  } catch(e) { showNotif('User load failed', 'error'); }
}

async function loadPendingPayments() {
  try {
    const data = await api('/payments?status=pending');
    const payments = data.payments || [];
    if (!payments.length) { showNotif('No pending payments!', 'success'); return; }
    document.getElementById('modal-body').innerHTML = `
      <h3><i class="fa fa-clock" style="color:var(--am);margin-right:8px"></i>Pending Payments (${payments.length})</h3>
      <div style="margin-top:14px;display:flex;flex-direction:column;gap:10px">
        ${payments.map(p => `
          <div style="background:var(--bg2);border:1px solid var(--b2);border-radius:10px;padding:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
              <b>${p.firstName} (${p.telegramId})</b>
              <span class="badge b-pending">${p.plan} — ₹${p.amount}</span>
            </div>
            <div style="font-size:11px;color:var(--t2);font-family:var(--mono);margin-bottom:10px">${new Date(p.createdAt).toLocaleString('en-IN')}</div>
            <div style="display:flex;gap:8px">
              <button class="modal-btn primary" onclick="approvePayment('${p._id}')"><i class="fa fa-check"></i> Approve</button>
              <button class="modal-btn danger" onclick="rejectPayment('${p._id}')"><i class="fa fa-times"></i> Reject</button>
            </div>
          </div>`).join('')}
      </div>
      <div class="modal-actions"><button class="modal-btn" onclick="closeModal()">Close</button></div>`;
    openModal();
  } catch(e) { showNotif('Payments load failed', 'error'); }
}

async function approvePayment(id) {
  try {
    await api(`/payments/${id}/approve`, { method: 'POST' });
    showNotif('✅ Payment approved! User notified.', 'success');
    closeModal(); loadLiveStats();
  } catch(e) { showNotif('Approval failed: ' + e.message, 'error'); }
}

async function rejectPayment(id) {
  try {
    await api(`/payments/${id}/reject`, { method: 'POST' });
    showNotif('❌ Payment rejected. User notified.', 'info');
    closeModal(); loadLiveStats();
  } catch(e) { showNotif('Rejection failed', 'error'); }
}

async function sendBroadcast() {
  const msg = prompt('Broadcast message (Markdown supported):');
  if (!msg) return;
  try {
    showNotif('Broadcasting...', 'info');
    const res = await api('/broadcast', { method: 'POST', body: JSON.stringify({ message: msg }) });
    showNotif(`✅ Sent to ${res.sent} users! Failed: ${res.failed}`, 'success');
  } catch(e) { showNotif('Broadcast failed', 'error'); }
}

async function fetchFreshOpps() {
  try {
    showNotif('Fetching opportunities...', 'info');
    const res = await api('/opportunities/fetch', { method: 'POST' });
    showNotif(`✅ ${res.fetched} opportunities fetched!`, 'success');
  } catch(e) { showNotif('Fetch failed', 'error'); }
}

// Override renderBots to show real bot status
async function renderBots() {
  try {
    const bs = await api('/bot-status');
    const container = document.getElementById('bots-container');
    if (!container) return;
    container.innerHTML = `
      <div class="bot-card active-bot" id="bot-card-1">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px">
          <div style="display:flex;align-items:center;gap:10px">
            <div style="font-size:24px">🤖</div>
            <div>
              <div style="font-weight:700;font-size:14px;font-family:var(--d)">YuvorAI Main Bot</div>
              <div style="font-size:11px;color:var(--t2)">AI Career OS</div>
            </div>
          </div>
          <span class="badge b-active"><span style="width:5px;height:5px;border-radius:50%;background:currentColor;display:inline-block"></span> ${bs.bot}</span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:12px">
          <div class="bs"><div class="bs-lbl">Database</div><div class="bs-val" style="color:${bs.database==='connected'?'var(--cy)':'var(--rd)'}">${bs.database}</div></div>
          <div class="bs"><div class="bs-lbl">Cache</div><div class="bs-val">${bs.cache}</div></div>
          <div class="bs"><div class="bs-lbl">RAM</div><div class="bs-val">${bs.memory}MB</div></div>
          <div class="bs"><div class="bs-lbl">Uptime</div><div class="bs-val">${Math.floor(bs.uptime/3600)}h ${Math.floor((bs.uptime%3600)/60)}m</div></div>
          <div class="bs"><div class="bs-lbl">Status</div><div class="bs-val" style="color:var(--cy)">Live</div></div>
        </div>
        <div class="bot-actions">
          <button class="bot-btn primary" onclick="fetchFreshOpps()"><i class="fa fa-rotate"></i> Fetch Opps</button>
          <button class="bot-btn" onclick="sendBroadcast()"><i class="fa fa-bullhorn"></i> Broadcast</button>
          <button class="bot-btn primary" onclick="loadPendingPayments()"><i class="fa fa-clock"></i> Payments</button>
        </div>
      </div>`;
  } catch(e) { console.warn('Bot status failed:', e.message); }
}

// Override renderConversations with real recent users
async function renderConversations() {
  try {
    const data  = await api('/users?limit=10');
    const tbody = document.getElementById('conv-tbody');
    if (!tbody || !data.users) return;
    tbody.innerHTML = data.users.map(u => `
      <tr>
        <td style="font-weight:500">${u.firstName || 'User'} (@${u.username || u.telegramId})</td>
        <td><span style="font-family:var(--mono);font-size:11px;color:var(--pu)">YuvorAI Main</span></td>
        <td style="font-size:12px;color:var(--t2)">${u.identity || 'confused_beginner'}</td>
        <td style="font-family:var(--mono);font-size:12px">${u.xp || 0} XP</td>
        <td><span class="badge ${u.plan==='free'?'b-pending':'b-active'}">${u.plan}</span></td>
        <td style="font-family:var(--mono);font-size:11px;color:var(--t2)">${new Date(u.createdAt).toLocaleDateString('en-IN')}</td>
        <td><div class="action-btns">
          <button class="action-btn" onclick="viewUser('${u.telegramId}')"><i class="fa fa-eye"></i></button>
        </div></td>
      </tr>`).join('');
  } catch(e) { console.warn('Conversations load failed:', e.message); }
}

</script>
</body>
</html>
