          <div class="audit-time">2m ago</div>
          <div><div class="audit-text">User banned for policy violation</div><div class="audit-user">by @admin_priya</div></div>
          <span class="audit-badge ab-red">Ban</span>
        </div>
        <div class="audit-row">
          <div class="audit-time">15m ago</div>
          <div><div class="audit-text">Bot "QuizMaster" configuration updated</div><div class="audit-user">by @admin</div></div>
          <span class="audit-badge ab-green">Update</span>
        </div>
        <div class="audit-row">
          <div class="audit-time">1h ago</div>
          <div><div class="audit-text">New admin role assigned to user</div><div class="audit-user">by @superadmin</div></div>
          <span class="audit-badge ab-am">Role</span>
