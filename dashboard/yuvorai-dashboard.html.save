          <span class="threat-sev sev-med">MED</span>
        </div>
        <div class="threat-row">
          <div class="threat-icon low"><i class="fa fa-robot"></i></div>
          <div class="threat-info"><div class="threat-name">Bot Traffic Spike</div><div class="threat-detail">+340% from API endpoint</div></div>
          <span class="threat-sev sev-low">LOW</span>
        </div>
        <div style="display:flex;gap:8px;margin-top:1rem;">
          <button class="tb-btn" style="flex:1;justify-content:center;" onclick="showNotif('All threats resolved!','success')"><i class="fa fa-check"></i> Resolve All</button>
          <button class="tb-btn" style="flex:1;justify-content:center;" onclick="showNotif('Security report generated!','info')"><i class="fa fa-download"></i> Export Report</button>
        </div>
      </div>
      <div class="sec-card">
        <h3><i class="fa fa-list" style="color:var(--bl)"></i> Audit Log</h3>
