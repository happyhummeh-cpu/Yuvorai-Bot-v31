const CONVERSATIONS = [
  {user:'Rahul Verma',bot:'Yuvora Main',last:'How do I solve differential equations?',msgs:47,status:'active',time:'2m ago'},
  {user:'Dev Mehta',bot:'StudyBot Pro',last:'Explain quantum mechanics basics',msgs:23,status:'active',time:'5m ago'},
