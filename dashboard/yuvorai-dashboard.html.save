          <div class="threat-icon high"><i class="fa fa-skull"></i></div>
          <div class="threat-info"><div class="threat-name">Brute Force Attempt</div><div class="threat-detail">IP: 192.168.1.45 • 247 attempts</div></div>
          <span class="threat-sev sev-high">HIGH</span>
        </div>
        <div class="threat-row">
