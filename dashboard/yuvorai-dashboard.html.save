        </div>
      </div>
    </div>

    <div class="cc" style="margin-bottom:1.2rem;">
      <div class="cc-title"><div class="dot dot-rd" style="width:6px;height:6px;border-radius:50%;background:var(--rd);display:inline-block"></div>Security Events — Last 30 Days</div>
      <canvas id="securityChart" height="120"></canvas>
    </div>
  </div>

  <!-- SETTINGS -->
  <div class="page" id="page-settings">
    <div class="sec-hdr">System Settings</div>
    <div class="settings-grid">
      <div class="settings-nav">
        <div class="sn-item active" onclick="switchSettings('general',this)"><i class="fa fa-sliders"></i>General</div>
        <div class="sn-item" onclick="switchSettings('ai',this)"><i class="fa fa-robot"></i>AI Config</div>
        <div class="sn-item" onclick="switchSettings('notifications',this)"><i class="fa fa-bell"></i>Notifications</div>
        <div class="sn-item" onclick="switchSettings('api',this)"><i class="fa fa-code"></i>API & Keys</div>
        <div class="sn-item" onclick="switchSettings('appearance',this)"><i class="fa fa-palette"></i>Appearance</div>
        <div class="sn-item" onclick="switchSettings('danger',this)"><i class="fa fa-triangle-exclamation" style="color:var(--rd)"></i>Danger Zone</div>
      </div>
      <div class="settings-panel">
        <!-- GENERAL -->
        <div class="sp active" id="sp-general">
          <div class="settings-section-title">General Settings</div>
          <div class="form-row">
            <div class="form-group"><div class="form-label">Platform Name</div><input class="form-input" value="YUVORAI" type="text"></div>
            <div class="form-group"><div class="form-label">Admin Email</div><input class="form-input" value="admin@yuvorai.ai" type="email"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><div class="form-label">Timezone</div><select class="form-select"><option>Asia/Kolkata (IST)</option><option>UTC</option><option>US/Eastern</option></select></div>
            <div class="form-group"><div class="form-label">Language</div><select class="form-select"><option>English</option><option>Hindi</option><option>Hinglish</option></select></div>
          </div>
          <div class="form-group" style="margin-bottom:14px;"><div class="form-label">Platform Description</div><textarea class="form-textarea">YUVORAI is an AI-powered learning platform for students.</textarea></div>
          <div class="setting-row"><div class="setting-info"><h4>Maintenance Mode</h4><p>Take the platform offline for maintenance</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input"><div class="toggle-track"></div></label></div>
          <div class="setting-row"><div class="setting-info"><h4>Registration Open</h4><p>Allow new users to register</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <button class="save-btn" onclick="showNotif('Settings saved!','success')"><i class="fa fa-check"></i> Save Changes</button>
        </div>
        <!-- AI CONFIG -->
        <div class="sp" id="sp-ai">
          <div class="settings-section-title">AI Configuration</div>
          <div class="form-row">
            <div class="form-group"><div class="form-label">AI Model</div><select class="form-select"><option>GPT-4o</option><option>Claude 3.5</option><option>Gemini Pro</option><option>Llama 3.1</option></select></div>
            <div class="form-group"><div class="form-label">Temperature</div><input class="form-input" type="number" value="0.7" min="0" max="1" step="0.1"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><div class="form-label">Max Tokens</div><input class="form-input" type="number" value="2048"></div>
            <div class="form-group"><div class="form-label">Response Timeout (s)</div><input class="form-input" type="number" value="30"></div>
          </div>
          <div class="form-group" style="margin-bottom:14px;"><div class="form-label">System Prompt</div><textarea class="form-textarea" style="min-height:100px;">You are YUVORAI, a helpful AI assistant for students. Be friendly, concise, and educational.</textarea></div>
          <div class="setting-row"><div class="setting-info"><h4>Content Moderation</h4><p>Auto-filter harmful content with AI</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <div class="setting-row"><div class="setting-info"><h4>Context Memory</h4><p>Remember conversation history per user</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <div class="setting-row"><div class="setting-info"><h4>Streaming Responses</h4><p>Show responses word by word</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <button class="save-btn" onclick="showNotif('AI config updated!','success')"><i class="fa fa-robot"></i> Save AI Settings</button>
        </div>
        <!-- NOTIFICATIONS -->
        <div class="sp" id="sp-notifications">
          <div class="settings-section-title">Notification Preferences</div>
          <div class="setting-row"><div class="setting-info"><h4>Security Alerts</h4><p>Get notified on security events</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <div class="setting-row"><div class="setting-info"><h4>New User Signups</h4><p>Alert on new registrations</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input"><div class="toggle-track"></div></label></div>
          <div class="setting-row"><div class="setting-info"><h4>Bot Errors</h4><p>Notify when bots fail or crash</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <div class="setting-row"><div class="setting-info"><h4>Daily Summary Email</h4><p>Receive daily platform metrics email</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <div class="setting-row"><div class="setting-info"><h4>Flagged Conversations</h4><p>Immediate alert on flagged chats</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <div class="form-group" style="margin-top:1rem;"><div class="form-label">Webhook URL</div><input class="form-input" type="url" placeholder="https://hooks.slack.com/..."></div>
          <button class="save-btn" onclick="showNotif('Notification settings saved!','success')"><i class="fa fa-bell"></i> Save Notifications</button>
        </div>
        <!-- API -->
        <div class="sp" id="sp-api">
          <div class="settings-section-title">API & Integration Keys</div>
          <div class="form-group" style="margin-bottom:14px;">
            <div class="form-label">OpenAI API Key</div>
            <div style="display:flex;gap:8px;">
              <input class="form-input" type="password" value="sk-proj-xxxxxxxxxxxxxxxx" style="flex:1;font-family:var(--mono);">
              <button class="tb-btn" onclick="showNotif('Key copied!','success')"><i class="fa fa-copy"></i></button>
            </div>
          </div>
          <div class="form-group" style="margin-bottom:14px;">
            <div class="form-label">YUVORAI Public API Key</div>
            <div style="display:flex;gap:8px;">
              <input class="form-input" type="text" value="yuv_live_a9f2k3m..." style="flex:1;font-family:var(--mono);">
              <button class="tb-btn" onclick="showNotif('New key generated!','info')"><i class="fa fa-rotate"></i> Regen</button>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group"><div class="form-label">Rate Limit (req/hr)</div><input class="form-input" type="number" value="10000"></div>
            <div class="form-group"><div class="form-label">Allowed Origins</div><input class="form-input" type="text" value="*.yuvorai.ai"></div>
          </div>
          <div class="setting-row"><div class="setting-info"><h4>API Access Enabled</h4><p>Allow external API access</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <button class="save-btn" onclick="showNotif('API settings updated!','success')"><i class="fa fa-code"></i> Save API Config</button>
        </div>
        <!-- APPEARANCE -->
        <div class="sp" id="sp-appearance">
          <div class="settings-section-title">Appearance</div>
          <div class="form-row">
            <div class="form-group"><div class="form-label">Primary Color</div><input class="form-input" type="color" value="#7c50ff" style="height:44px;padding:4px 8px;"></div>
            <div class="form-group"><div class="form-label">Accent Color</div><input class="form-input" type="color" value="#e879f9" style="height:44px;padding:4px 8px;"></div>
          </div>
          <div class="form-group" style="margin-bottom:14px;"><div class="form-label">Platform Logo URL</div><input class="form-input" type="url" placeholder="https://yuvorai.ai/logo.png"></div>
          <div class="setting-row"><div class="setting-info"><h4>Dark Mode (Default)</h4><p>Force dark mode for all users</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <div class="setting-row"><div class="setting-info"><h4>Animated Background</h4><p>Show particles and gradients</p></div><label class="toggle-switch"><input type="checkbox" class="toggle-input" checked><div class="toggle-track"></div></label></div>
          <button class="save-btn" onclick="showNotif('Appearance saved!','success')"><i class="fa fa-palette"></i> Apply Theme</button>
        </div>
        <!-- DANGER -->
        <div class="sp" id="sp-danger">
          <div class="settings-section-title">Danger Zone</div>
          <div class="danger-zone">
            <h4><i class="fa fa-triangle-exclamation"></i> Irreversible Actions</h4>
            <div style="display:flex;flex-direction:column;gap:10px;">
              <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <div><div style="font-size:13px;font-weight:500;">Clear All Conversations</div><div style="font-size:11px;color:var(--t2);margin-top:2px;">Permanently delete all chat history</div></div>
                <button class="dz-btn" onclick="showConfirm('Clear all conversations?','This will permanently delete all conversation history.','clearConversations')"><i class="fa fa-trash"></i> Clear</button>
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <div><div style="font-size:13px;font-weight:500;">Reset All Bots</div><div style="font-size:11px;color:var(--t2);margin-top:2px;">Reset all bot configurations to default</div></div>
                <button class="dz-btn" onclick="showConfirm('Reset all bots?','Bot configs will revert to factory settings.','resetBots')"><i class="fa fa-rotate"></i> Reset</button>
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <div><div style="font-size:13px;font-weight:500;">Delete Platform</div><div style="font-size:11px;color:var(--t2);margin-top:2px;">Permanently delete all data and accounts</div></div>
                <button class="dz-btn" onclick="showConfirm('DELETE PLATFORM?','This will permanently destroy EVERYTHING. Are you absolutely sure?','deletePlatform')"><i class="fa fa-skull"></i> DELETE</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div><!-- end main -->

